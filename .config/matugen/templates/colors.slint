// ~/.config/matugen/templates/colors.slint

export global Colors {
    // Primary
    out property <color> primary: {{colors.primary.default.hex}};
    out property <color> on-primary: {{colors.on_primary.default.hex}};
    out property <color> primary-container: {{colors.primary_container.default.hex}};
    out property <color> on-primary-container: {{colors.on_primary_container.default.hex}};
    out property <color> inverse-primary: {{colors.inverse_primary.default.hex}};

    // Secondary
    out property <color> secondary: {{colors.secondary.default.hex}};
    out property <color> on-secondary: {{colors.on_secondary.default.hex}};
    out property <color> secondary-container: {{colors.secondary_container.default.hex}};
    out property <color> on-secondary-container: {{colors.on_secondary_container.default.hex}};

    // Tertiary
    out property <color> tertiary: {{colors.tertiary.default.hex}};
    out property <color> on-tertiary: {{colors.on_tertiary.default.hex}};
    out property <color> tertiary-container: {{colors.tertiary_container.default.hex}};
    out property <color> on-tertiary-container: {{colors.on_tertiary_container.default.hex}};

    // Error
    out property <color> error: {{colors.error.default.hex}};
    out property <color> on-error: {{colors.on_error.default.hex}};
    out property <color> error-container: {{colors.error_container.default.hex}};
    out property <color> on-error-container: {{colors.on_error_container.default.hex}};

    // Background
    out property <color> background: {{colors.background.default.hex}};
    out property <color> on-background: {{colors.on_background.default.hex}};

    // Surface
    out property <color> surface: {{colors.surface.default.hex}};
    out property <color> on-surface: {{colors.on_surface.default.hex}};

    out property <color> surface-variant: {{colors.surface_variant.default.hex}};
    out property <color> on-surface-variant: {{colors.on_surface_variant.default.hex}};

    out property <color> surface-dim: {{colors.surface_dim.default.hex}};
    out property <color> surface-bright: {{colors.surface_bright.default.hex}};

    out property <color> surface-container-lowest: {{colors.surface_container_lowest.default.hex}};
    out property <color> surface-container-low: {{colors.surface_container_low.default.hex}};
    out property <color> surface-container: {{colors.surface_container.default.hex}};
    out property <color> surface-container-high: {{colors.surface_container_high.default.hex}};
    out property <color> surface-container-highest: {{colors.surface_container_highest.default.hex}};

    // Outline
    out property <color> outline: {{colors.outline.default.hex}};
    out property <color> outline-variant: {{colors.outline_variant.default.hex}};

    // Misc
    out property <color> shadow: {{colors.shadow.default.hex}};
    out property <color> scrim: {{colors.scrim.default.hex}};

    // Inverse
    out property <color> inverse-surface: {{colors.inverse_surface.default.hex}};
    out property <color> inverse-on-surface: {{colors.inverse_on_surface.default.hex}};

    // Fixed colors
    out property <color> primary-fixed: {{colors.primary_fixed.default.hex}};
    out property <color> primary-fixed-dim: {{colors.primary_fixed_dim.default.hex}};
    out property <color> on-primary-fixed: {{colors.on_primary_fixed.default.hex}};
    out property <color> on-primary-fixed-variant: {{colors.on_primary_fixed_variant.default.hex}};

    out property <color> secondary-fixed: {{colors.secondary_fixed.default.hex}};
    out property <color> secondary-fixed-dim: {{colors.secondary_fixed_dim.default.hex}};
    out property <color> on-secondary-fixed: {{colors.on_secondary_fixed.default.hex}};
    out property <color> on-secondary-fixed-variant: {{colors.on_secondary_fixed_variant.default.hex}};

    out property <color> tertiary-fixed: {{colors.tertiary_fixed.default.hex}};
    out property <color> tertiary-fixed-dim: {{colors.tertiary_fixed_dim.default.hex}};
    out property <color> on-tertiary-fixed: {{colors.on_tertiary_fixed.default.hex}};
    out property <color> on-tertiary-fixed-variant: {{colors.on_tertiary_fixed_variant.default.hex}};
}
